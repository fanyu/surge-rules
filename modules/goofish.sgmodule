#!name=闲鱼去广告
#!desc=剔除闲鱼首页信息流与搜索结果中的广告卡片
#!category=自建
#!author=改编自 https://github.com/androidcn/userscripts （goofish.sgmodule），脚本已自托管

[Script]
goofish = type=http-response, pattern=^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\/, requires-body=true, max-size=3145728, script-path=https://raw.githubusercontent.com/fanyu/surge-rules/main/modules/scripts/goofish.js, timeout=60, script-update-interval=86400
goofishSearch = type=http-response, pattern=^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\/, requires-body=true, max-size=3145728, script-path=https://raw.githubusercontent.com/fanyu/surge-rules/main/modules/scripts/goofishSearch.js, timeout=60, script-update-interval=86400

[MITM]
hostname = %APPEND% g-acs.m.goofish.com
